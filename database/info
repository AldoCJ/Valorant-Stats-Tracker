Tables
Players (
    id INT AUTO_INCREMENT PRIMARY KEY,  -- Unique ID for each player
    player VARCHAR(50) NOT NULL,        -- Player name (e.g., "bones")
    org VARCHAR(50),                    -- Organization (e.g., "Land")
    rounds_played INT,                  -- Rounds played (e.g., 276)
    rating DECIMAL(5, 2),               -- Rating (e.g., 1.23)
    average_combat_score DECIMAL(5, 1), -- Average combat score (e.g., 263.9)
    kill_deaths DECIMAL(5, 2),          -- Kill/Death ratio (e.g., 1.36)
    kill_assists_survived_traded VARCHAR(10), -- KAST percentage (e.g., "76%")
    average_damage_per_round DECIMAL(5, 1),   -- Average damage per round (e.g., 168.5)
    kills_per_round DECIMAL(3, 2),      -- Kills per round (e.g., 0.94)
    assists_per_round DECIMAL(3, 2),    -- Assists per round (e.g., 0.19)
    first_kills_per_round DECIMAL(3, 2), -- First kills per round (e.g., 0.19)
    first_deaths_per_round DECIMAL(3, 2), -- First deaths per round (e.g., 0.17)
    headshot_percentage VARCHAR(10),    -- Headshot percentage (e.g., "23%")
    clutch_success_percentage VARCHAR(10), -- Clutch success percentage (e.g., "24%")
    UNIQUE (player)
    region VARCHAR(2)
);

Agents (
    agent_id INT AUTO_INCREMENT PRIMARY KEY,  -- Unique numeric ID for each agent
    agent_name VARCHAR(50) NOT NULL UNIQUE    -- Agent name (e.g., "raze", "jett")
);

Agents_Played
(
	PRIMARY KEY (player, agent_name),
    player VARCHAR(50) NOT NULL,
    agent_name VARCHAR(50) NOT NULL,
    FOREIGN KEY (player) REFERENCES players(player),
    FOREIGN KEY (agent_name) REFERENCES agents(agent_name)
);

Teams
(
    id INT AUTO_INCREMENT PRIMARY KEY,
    ranking INT UNIQUE,
    team VARCHAR(50) NOT NULL UNIQUE, 
    country VARCHAR(50),
    last_played VARCHAR(50),
    last_played_team VARCHAR(50),
    last_played_team_logo VARCHAR(100), -- URL to the logo image (e.g., "https://example.com/logo.png")
    record VARCHAR(50),
    earnings VARCHAR(50),
    logo VARCHAR(100), 
    region VARCHAR(2),
);

Upcoming_Matches
(
    id INT AUTO_INCREMENT PRIMARY KEY,
    team1 VARCHAR(50) NOT NULL REFERENCES teams(team),
    team2 VARCHAR(50) NOT NULL REFERENCES teams(team), 
    flag1 VARCHAR(100), 
    flag2 VARCHAR(100), 
    series VARCHAR(150), 
    event VARCHAR(150),
    time DATETIME,
    page VARCHAR(150),
);

Recent_Matches
(
    id INT AUTO_INCREMENT PRIMARY KEY,
    team1 VARCHAR(50) NOT NULL REFERENCES teams(team),
    team2 VARCHAR(50) NOT NULL REFERENCES teams(team), 
    score1 INT NOT NULL,
    score2 INT NOT NULL,
    flag1 VARCHAR(100),
    flag2 VARCHAR(100),
    series VARCHAR(150), 
    event VARCHAR(150),
    time DATETIME,
    page VARCHAR(150),
    tournament_icon VARCHAR(150)
)



